rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Projects collection for Solar Design Pipeline
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if true;
    }

    // Incomes collection
    match /incomes/{incomeId} {
      allow read: if true;
      allow write: if true;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
